# QuickFix Frontend Environment Variables Template
# Copy this to .env (for local dev) or set these in your Vercel / Netlify dashboard

# Backend API endpoint
# For local dev: http://localhost:8000/api/v1
# For production: https://api.quickfix.yourdomain.com/api/v1 (or your Render/Railway URL)
VITE_API_URL=http://localhost:8000/api/v1

# Realtime WebSocket endpoint
# For local dev: ws://localhost:8000/ws
# For production: wss://api.quickfix.yourdomain.com/ws (or your Render/Railway URL)
VITE_WS_URL=ws://localhost:8000/ws

# Razorpay Payment Gateway Key (rzp_test_... or rzp_live_...)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_here

# Optional: Supabase & Google Maps (if using external providers)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
