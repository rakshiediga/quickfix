# Database (Render PostgreSQL or SQLite fallback)
DATABASE_URL=sqlite:///./quickfix.db

# Server base URL for uploaded file links (e.g. https://<your-render-subdomain>.onrender.com)
SERVER_BASE_URL=

# Environment
ENVIRONMENT=production

# JWT Authentication
JWT_SECRET=generate_a_random_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=

# SMTP Email Configuration for OTPs (Optional - if blank, OTP will be logged to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@quickfix.com

# Static files / Uploads folder
UPLOAD_DIR=uploads
